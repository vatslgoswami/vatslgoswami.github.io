---
import type { CollectionEntry } from 'astro:content';
import ContentRow from './ContentRow.astro';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { title, date, externalUrl, description, tags = [] } = post.data;
const href = externalUrl ?? `/research/${post.id}/`;
const externalHost = externalUrl ? new URL(externalUrl).hostname.replace(/^www\./, '') : undefined;
---

<li>
	<ContentRow {title} year={date.getUTCFullYear()} kind="Research" {href} summary={description} {tags} datetime={date.toISOString().slice(0, 10)} {externalHost} />
</li>
