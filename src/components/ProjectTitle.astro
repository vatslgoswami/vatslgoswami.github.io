---
interface Props {
	title: string;
	href?: string;
	githubUrl?: string;
	level: 'h1' | 'h3';
}

const { title, href, githubUrl, level: Heading } = Astro.props;
---

<Heading class:list={['project-title', Heading]}>
	{href ? <a class="title-link" href={href}>{title}</a> : title}{githubUrl && <> <span class="divider" aria-hidden="true">|</span> <a class="github" href={githubUrl}><svg aria-hidden="true" viewBox="0 0 16 16" width="1em" height="1em" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.49c-2.23.48-2.69-.94-2.69-.94-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.22.82 1.22.82.71 1.21 1.87.86 2.33.66.07-.52.28-.86.51-1.06-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 4.87c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg> Github</a></>}
</Heading>

<style>
	.project-title { font-weight: 700; letter-spacing: -0.01em; }
	.h1 { margin: 0 0 6px; font-size: 28px; }
	.h3 { margin: 4px 0; font-size: 19px; }
	.title-link { color: var(--fg); border-bottom: 0; }
	.title-link:hover { color: var(--salmon); }
	.divider { color: var(--muted); font-weight: 400; }
	.github { display: inline-flex; align-items: center; gap: 5px; font-size: 0.85em; white-space: nowrap; }
	.h3 .github { color: var(--fg); border-bottom: 0; }
	.h3 .github:hover { color: var(--salmon); }
</style>
