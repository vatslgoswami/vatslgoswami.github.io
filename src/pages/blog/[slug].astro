---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { getPosts } from '../../lib/content';

// Posts with externalUrl live elsewhere, so only native posts get a page.
export async function getStaticPaths() {
	const posts = await getPosts();
	return posts
		.filter((post) => !post.data.externalUrl)
		.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, description, tags } = post.data;
const { Content } = await render(post);
const label = date.toLocaleDateString('en-US', {
	month: 'short',
	day: '2-digit',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<Base title={title} description={description}>
	<article>
		<header>
			<h1 class="page-title">{title}</h1>
			<time class="page-meta" datetime={date.toISOString().slice(0, 10)}>{label}</time>
			{description && <p class="post-description">{description}</p>}
			{tags.length > 0 && <div class="post-tags">{tags.map((tag) => <span>{tag}</span>)}</div>}
		</header>
		<ArticleBody backHref="/blog/" backLabel="All posts"><Content /></ArticleBody>
	</article>
</Base>

<style>
	.post-description { margin: 12px 0 0; color: var(--muted); }
	.post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
	.post-tags span { font-family: var(--mono); font-size: var(--text-micro); padding: 1px 8px; border-radius: 999px; background: var(--mustard-soft); color: var(--mustard-ink); }
	:global(.prose .katex-display) { overflow-x: auto; overflow-y: hidden; padding: 0.35em 0; }
</style>
