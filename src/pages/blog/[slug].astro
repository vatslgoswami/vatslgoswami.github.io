---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

// Posts with externalUrl live elsewhere, so only native posts get a page.
export async function getStaticPaths() {
	const posts = await getPosts();
	return posts
		.filter((post) => !post.data.externalUrl)
		.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, date, description } = post.data;
const { Content } = await render(post);
const label = date.toLocaleDateString('en-US', {
	month: 'short',
	day: '2-digit',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<Base title={title} description={description}>
	<article>
		<header>
			<h1>{title}</h1>
			<time datetime={date.toISOString().slice(0, 10)}>{label}</time>
		</header>
		<div class="prose">
			<Content />
		</div>
		<p class="back"><a href="/blog/">← All posts</a></p>
	</article>
</Base>

<style>
	article {
		max-width: 65ch;
	}

	h1 {
		margin: 0 0 6px;
		font-size: 28px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	time {
		font-family: var(--mono);
		font-size: 13px;
		color: var(--muted);
	}

	.prose {
		margin-top: 24px;
	}

	.prose :global(img) {
		border-radius: 4px;
	}

	.prose :global(pre) {
		overflow-x: auto;
		padding: 12px 14px;
		border-radius: 4px;
		font-size: 14px;
	}

	.prose :global(code) {
		font-family: var(--mono);
		font-size: 0.9em;
	}

	.prose :global(blockquote) {
		margin: 0;
		padding-left: 16px;
		border-left: 3px solid var(--mustard-soft);
		color: var(--muted);
	}

	.back {
		margin-top: 36px;
		font-size: 15px;
	}
</style>
