---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects
		.filter((project) => project.data.detail)
		.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, year, kind, summary, links } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
	<article>
		<header>
			<h1>{title}</h1>
			<div class="meta">{year} · {kind}</div>
			{links.length > 0 && <p class="links">{links.map((link) => <a href={link.url}>{link.label} ↗</a>)}</p>}
		</header>
		<div class="prose"><Content /></div>
		<p class="back"><a href="/projects/">← All projects</a></p>
	</article>
</Base>

<style>
	article { max-width: 65ch; }
	h1 { margin: 0 0 6px; font-size: 28px; font-weight: 700; letter-spacing: -0.01em; }
	.meta { font-family: var(--mono); font-size: 13px; color: var(--muted); }
	.links { display: flex; flex-wrap: wrap; gap: 12px; margin: 12px 0 0; font-family: var(--mono); font-size: 13px; }
	.prose { margin-top: 24px; }
	.back { margin-top: 36px; font-size: 15px; }
</style>
