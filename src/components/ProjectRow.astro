---
import type { CollectionEntry } from 'astro:content';
import ContentRow from './ContentRow.astro';

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { title, year, kind, summary, tags, links, image } = project.data;
const githubLink = links.find((link) => link.label.toLowerCase() === 'github');
const otherLinks = links.filter((link) => link !== githubLink);
const href = project.data.detail ? `/projects/${project.id}/` : links[0]?.url;
---

<ContentRow {title} {year} {kind} {href} {tags} {image} summary={summary} githubUrl={githubLink?.url} links={otherLinks} />
