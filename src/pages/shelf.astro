---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getShelf } from '../lib/content';

const items = await Promise.all(
	(await getShelf()).map(async (item) => ({ item, Notes: (await render(item)).Content })),
);

const byYear = new Map<number, typeof items>();
for (const entry of items) {
	const year = entry.item.data.added.getUTCFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), entry]);
}
---

<Base title="Shelf" description={site.shelfIntro}>
	<h1 class="visually-hidden">Shelf</h1>
	<p class="intro">{site.shelfIntro}</p>
	{items.length === 0 && <p class="empty">Nothing on the shelf yet.</p>}
	{[...byYear].map(([year, entries]) => (
		<section>
			<h2 class="year">{year}</h2>
			<ul class="items">
				{entries.map(({ item, Notes }) => (
					<li class="item">
						<a href={item.data.url}>{item.data.title}</a>{item.data.author && !item.data.title.toLowerCase().includes(item.data.author.toLowerCase()) && <> by {item.data.author}</>}
						{item.body?.trim() && <div class="notes"><Notes /></div>}
					</li>
				))}
			</ul>
		</section>
	))}
</Base>

<style>
	.intro { margin: 0 0 24px; }
	.year { margin: 28px 0 12px; font-family: var(--mono); font-size: 22px; font-weight: 600; color: var(--salmon); }
	.items { margin: 0; padding-left: 22px; }
	.item { padding-left: 2px; margin-bottom: 14px; font-size: 19px; }
	.item > a { font-weight: 500; }
	.notes { color: #4a4a4a; font-size: 17px; }
	.notes :global(ul) { margin: 4px 0 0; padding-left: 22px; list-style: none; }
	.notes :global(li) { position: relative; }
	.notes :global(li)::before { content: '→'; position: absolute; right: calc(100% + 8px); }
	.notes :global(p) { margin: 4px 0 0; }
	.notes :global(li + li) { margin-top: 3px; }
</style>
