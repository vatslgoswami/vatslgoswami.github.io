---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PostRow from '../components/PostRow.astro';
import { Content as Bio } from '../data/about.md';
import { site } from '../data/site';
import { getPosts, getProjects } from '../lib/content';

const recentPosts = (await getPosts()).slice(0, 3);
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 2);

// Fall back to a placeholder until public/photo.jpg is added.
const hasPhoto = existsSync(join(process.cwd(), 'public', site.photo));
---

<Base>
	<section class="hero">
		{
			hasPhoto ? (
				<img class="photo" src={site.photo} alt={`Photo of ${site.name}`} width="235" height="235" />
			) : (
				<div class="photo placeholder" aria-hidden="true">photo</div>
			)
		}
		<div class="bio">
			<Bio />
			<ul class="chips">
				{
					site.socials.map((s) => (
						<li>
							<a class="chip" href={s.url}>
								{s.label}
							</a>
						</li>
					))
				}
				<li><a class="chip" href={site.cv}>CV (PDF)</a></li>
			</ul>
		</div>
	</section>

	{
		recentPosts.length > 0 && (
			<section class="block">
				<h2 class="section-head">
					Recent writing <a href="/blog/">all →</a>
				</h2>
				<ul class="posts">
					{recentPosts.map((post) => (
						<PostRow post={post} withYear />
					))}
				</ul>
			</section>
		)
	}

	{
		featured.length > 0 && (
			<section class="block">
				<h2 class="section-head">
					Selected projects <a href="/projects/">all →</a>
				</h2>
				{featured.map((project) => (
					<ProjectRow project={project} />
				))}
			</section>
		)
	}
</Base>

<style>
	/*
	 * The bio's children join the hero grid (display: contents) so the photo can share
	 * rows with the bio: the photo is as wide as the name in the header and as tall
	 * as both paragraphs plus the social chips.
	 */
	.hero {
		--photo-width: 235px;
		display: grid;
		grid-template-columns: var(--photo-width) minmax(0, 1fr);
		column-gap: 28px;
		row-gap: 12px;
	}

	.bio {
		display: contents;
	}

	.bio > :global(*) {
		grid-column: 2;
	}

	.photo {
		grid-row: 1 / span 3;
		grid-column: 1;
		display: block;
		width: 100%;
		/* Fill the rows without sizing them; the bio sets the height. */
		height: 0;
		min-height: 100%;
		aspect-ratio: auto;
		contain: size;
		object-fit: cover;
		object-position: 50% 30%;
		border-radius: 8px;
	}

	.placeholder {
		display: grid;
		place-items: center;
		background: #f3f3f1;
		border: 1px dashed #d6d6d2;
		font-family: var(--mono);
		font-size: 11px;
		color: var(--muted);
	}

	.bio :global(p) {
		margin: 0;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 4px 0 0;
		padding: 0;
		list-style: none;
	}

	.chip {
		display: inline-block;
		padding: 3px 11px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--fg);
	}

	.chip:hover {
		border-color: var(--salmon);
	}

	.block {
		margin-top: 40px;
	}

	@media (max-width: 600px) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
		}

		.bio > :global(*) {
			grid-column: 1;
		}

		.photo {
			width: var(--photo-width);
			height: var(--photo-width);
			margin-bottom: 6px;
		}
	}
</style>
